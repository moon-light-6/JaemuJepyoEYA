# .env.example → .env로 복사해서 값을 채운다 (.env는 git에 올라가지 않음)
OPENAI_API_KEY=
DART_API_KEY=
# vLLM 전환 시 (vLLM은 키를 검사하지 않으면 아무 값이나 가능)
VLLM_API_KEY=EMPTY
# 재무제표 수치 DB (PostgreSQL / Supabase). 비밀번호가 들어가므로 .env 에만 넣고 공유는 직접 전달.
# 예: postgresql://postgres:<비밀번호>@db.<프로젝트ref>.supabase.co:5432/postgres
DATABASE_URL=
